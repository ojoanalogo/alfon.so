---
import DesktopClientGate from '@/desktop/DesktopClientGate';
import AboutContent from '@/desktop/apps/about/AboutContent';
import Card from '../components/ui/Card.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DESKTOP_ICON_URLS } from '@desktop/lib/desktopIcons';
import { getPublishedPosts, prepareBlogPost } from '../lib/blog';
import {
  fetchGithubContributions,
  githubUsernameFromSocialLinks,
} from '../lib/githubContributions';
import { sortMDByDate } from '../utils';
import type { BlogPostSummary } from '@/desktop/types';

const MAX_POSTS = 10;
const entries = sortMDByDate(await getPublishedPosts()).slice(0, MAX_POSTS);
const posts: BlogPostSummary[] = await Promise.all(entries.map((entry) => prepareBlogPost(entry)));
const githubContributions = await fetchGithubContributions(githubUsernameFromSocialLinks());
---

<BaseLayout desktop navbarActiveItemID="home">
  <section class="sm:hidden" aria-label="Mi info">
    <Card>
      <AboutContent
        client:media="(max-width: 39.999rem)"
        posts={posts}
        contributions={githubContributions}
      />
    </Card>
  </section>

  <div class="relative hidden h-dvh w-full overflow-hidden sm:block">
    <DesktopClientGate
      client:media="(min-width: 40rem)"
      posts={posts}
      desktopIconUrls={DESKTOP_ICON_URLS}
      githubContributions={githubContributions}
    />
  </div>
</BaseLayout>
